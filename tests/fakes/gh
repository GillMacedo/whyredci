#!/usr/bin/env python3
"""Stands in for gh in tests and the demo: serves made-up API responses from tests/fixtures."""
import json, os, sys
from pathlib import Path

args = sys.argv[1:]
if os.environ.get("FAKE_LOG"):
    with open(os.environ["FAKE_LOG"], "a") as log:
        log.write("gh " + " ".join(args) + "\n")
path = args[1]
for denied in os.environ.get("FAKE_DENY", "").split(","):
    if denied and denied in path:
        sys.stderr.write("gh: HTTP 410: Gone\n")
        sys.exit(1)
routes = json.loads((Path(__file__).resolve().parent.parent / "fixtures" / "routes.json").read_text())
scenario = os.environ.get("FAKE_SCENARIO", "base")
table = dict(routes["base"], **routes.get(scenario, {}))
if path not in table:
    sys.stderr.write(f"gh: HTTP 404: no fixture for {path}\n")
    sys.exit(1)
answer = table[path]
text = answer if isinstance(answer, str) else json.dumps(answer)
# Built here so nothing token-shaped is stored in the repo.
print(text.replace("FAKE_TOKEN_SHAPE", "gh" + "p_" + "abcdefghijklmnopqrstuvwxyz123456"))
